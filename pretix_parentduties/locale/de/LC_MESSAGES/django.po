msgid "A sibling is already registered"
msgstr "Ein Geschwisterkind ist schon angemeldet"

#: forms.py:44
msgid "Unfortunately we cannot take on a duty"
msgstr "Wir können leider keinen Dienst übernehmen"

#: forms.py:46
