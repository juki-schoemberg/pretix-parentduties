msgstr "Ihr könnt höchstens %(max)s Dienste wählen."

#: forms.py:96 forms.py:160
#, python-format
msgid "The duty “%(name)s” is already full, please choose another one."
msgstr "Der Dienst „%(name)s“ ist schon voll, bitte wählt einen anderen."

#: forms.py:105
msgid "Please enter the order code of the other registration."
msgstr "Bitte gebt den Bestellcode der anderen Anmeldung ein."

#: forms.py:108
msgid "Please tell us briefly why."
msgstr "Bitte sagt uns kurz, warum."

#: forms.py:111 forms.py:113
msgid "This field is required."
msgstr "Dieses Feld ist erforderlich."

#: forms.py:221
msgid "The end time must not be before the start time."
msgstr "Das Ende darf nicht vor dem Beginn liegen."

#: forms.py:242 templates/pretix_parentduties/signups.html:24
#: templates/pretix_parentduties/signups.html:73
msgid "Order code"
msgstr "Bestellcode"

