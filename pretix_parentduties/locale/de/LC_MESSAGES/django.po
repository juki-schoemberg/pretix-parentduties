#: reminder.py:13
#, python-brace-format
msgid ""
"Hello,\n"
"\n"
"{event} is coming up soon – thank you for lending a hand! This is your "
"parent duty:\n"
"\n"
"{parent_duty}\n"
"{parent_duty_description}\n"
"\n"
"You can find all details here:\n"
"{parent_duty_url}\n"
"\n"
"If something has come up, please let us know as soon as possible.\n"
"\n"
"See you soon!\n"
"{event}"
msgstr ""
"Hallo,\n"
"\n"
"bald geht es los mit {event} – danke, dass ihr mit anpackt! Das ist euer "
"Elterndienst:\n"
"\n"
"{parent_duty}\n"
"{parent_duty_description}\n"
"\n"
"Alle Details findet ihr hier:\n"
"{parent_duty_url}\n"
"\n"
"Falls etwas dazwischengekommen ist, meldet euch bitte so bald wie möglich "
"bei uns.\n"
"\n"
"Bis bald!\n"
"{event}"

